---
/**
 * 作品一覧。
 *
 * 【出し分け】
 *  作品データの embedType に応じて表示形式が変わる。
 *   - 'iframe' : 別サイトとして作った作品を画面内に埋め込む（Web・LP向け）
 *   - 'link'   : サムネイル＋別タブで開くリンク
 *   - 'image'  : 画像を直接表示
 *  URL や画像が未設定のものは「準備中」の表示になるので、
 *  実際の作品ができたら site.ts にデータを足すだけでよい。
 *
 * 【レイアウト】
 *   - 'grid'  : 並べる（Web・LP向け）
 *   - 'stack' : 1件ずつ大きく縦に並べる（図版が主役のカテゴリ向け）
 */
import type { Work } from '../config/site';

interface Props {
  works: Work[];
  layout?: 'grid' | 'stack';
  /** iframe を実際に埋め込むか。一覧では重くなるため既定は false */
  enableIframe?: boolean;
}

const { works, layout = 'grid', enableIframe = false } = Astro.props;
---

<ul class={`works works--${layout}`}>
  {
    works.map((work) => (
      <li class="work">
        <article class="work__card">
          <div class="work__media">
            {work.embedType === 'iframe' && work.url && enableIframe ? (
              <iframe
                class="work__iframe"
                src={work.url}
                title={work.title}
                loading="lazy"
                sandbox="allow-scripts allow-same-origin allow-popups"
                referrerpolicy="no-referrer"
              />
            ) : work.image ? (
              <img src={work.image} alt={work.title} loading="lazy" decoding="async" />
            ) : (
              <p class="work__pending">準備中</p>
            )}
          </div>

          <div class="work__body">
            <h3 class="work__title">{work.title}</h3>
            <p class="work__summary">{work.summary}</p>

            {layout === 'stack' && work.description && (
              <p class="work__summary">{work.description}</p>
            )}

            <p class="work__meta">
              {work.year && <span>{work.year}</span>}
              {work.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </p>

            {work.url && (
              <p class="work__link">
                <a class="link" href={work.url} target="_blank" rel="noopener noreferrer">
                  サイトを開く
                </a>
              </p>
            )}
          </div>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .works {
    display: grid;
  }

  /* ---------------- 並べる ---------------- */
  .works--grid {
    gap: var(--space-xl);
    /* 画像が入る列は minmax(0, 1fr) にして、はみ出しを防ぐ */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  /* ---------------- 1件ずつ大きく縦に ---------------- */
  .works--stack {
    gap: var(--space-3xl);
    grid-template-columns: minmax(0, 1fr);
  }

  .works--stack .work__card {
    max-width: 44rem;
  }

  .work__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
  }

  /* 図版。影は付けず、罫線と下地だけで示す */
  .work__media {
    display: grid;
    place-items: center;
    background: var(--color-paper-2);
    border: var(--rule-width) solid var(--color-rule);
    overflow: hidden;
  }

  .works--grid .work__media {
    aspect-ratio: 16 / 10;
  }

  .work__pending {
    font-size: var(--text-sm);
    color: var(--color-neutral);
    letter-spacing: var(--tracking-label);
  }

  .work__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .works--stack .work__media img {
    height: auto;
    object-fit: contain;
  }

  .work__iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .work__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-top: var(--space-md);
  }

  .work__title {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .work__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    color: var(--color-muted);
  }

  /* 年と分類。点で区切った一行にする */
  .work__meta {
    margin-top: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-neutral);
    letter-spacing: 0.06em;
  }

  .work__meta span + span::before {
    content: '・';
    color: var(--color-rule-strong);
  }

  .work__link {
    margin-top: var(--space-xs);
  }
</style>
