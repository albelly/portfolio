---
/**
 * フッター。奥付のように、静かに情報だけを置く。
 */
import { profile, navItems } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__identity">
      <p class="site-footer__name">{profile.name}</p>
      <p class="site-footer__role">{profile.role}</p>
    </div>

    <nav class="site-footer__nav" aria-label="フッター">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/#contact">ご依頼・ご相談</a></li>
      </ul>
    </nav>
  </div>

  <p class="site-footer__copy">&copy; {year} {profile.name}</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-xl) var(--space-lg);
    border-top: var(--rule-width) solid var(--color-rule);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .site-footer__role {
    font-size: var(--text-xs);
    color: var(--color-neutral);
    letter-spacing: var(--tracking-label);
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    font-size: var(--text-sm);
  }

  .site-footer__nav a {
    color: var(--color-muted);
    white-space: nowrap;
  }

  .site-footer__nav a:hover {
    color: var(--color-accent);
  }

  .site-footer__copy {
    margin-top: var(--space-xl);
    font-size: var(--text-xs);
    color: var(--color-neutral);
    letter-spacing: 0.06em;
  }
</style>
