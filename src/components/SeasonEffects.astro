---
/**
 * 季節のモチーフ。
 *
 * 4季節ぶんをすべて書き出しておき、CSS で現在の季節だけを表示する。
 * こうすると切り替えが即座で、動くのは表示中の季節の分だけになる。
 *
 * 位置・速度・大きさ・揺れ幅は、固定の種から作った乱数でビルド時に決める。
 * 実行時の JavaScript は使わない。図版はすべて SVG / CSS の自作で、外部素材は無い。
 *
 * 【強さの調整はここ】
 *   COUNTS … 枚数・粒数
 *   各 make... の dur … 落ちる速さ（秒）
 *   sway … 横揺れの幅
 * 濃さと色は seasons.css の --fx-o / --fx-l で調整する。
 */

/** 毎回同じ並びになるよう、種を決めた簡単な乱数を使う */
function makeRng(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

const rng = makeRng(20260916);
const pick = (min: number, max: number) => min + rng() * (max - min);
const f = (n: number, d = 1) => n.toFixed(d);

/* --- 強さの設定 --- */
const COUNTS = {
  petal: 30, // 桜の花びら
  leaf: 26, // 紅葉
  snow: 50, // 雪
  ray: 6, // 光芒
  mote: 28, // 空気中の光の粒
};

type Bit = { style: string; cls?: string };

/** 舞い落ちるものを作る */
function makeFalling(n: number, sizeMin: number, sizeMax: number, durMin: number, durMax: number) {
  const bits: Bit[] = [];
  for (let i = 0; i < n; i++) {
    bits.push({
      style: [
        `--x:${f(pick(-4, 100), 2)}%`,
        `--size:${f(pick(sizeMin, sizeMax))}px`,
        `--dur:${f(pick(durMin, durMax), 2)}s`,
        `--delay:${f(-pick(0, durMax), 2)}s`,
        `--sway:${f(pick(20, 90), 0)}px`,
      ].join(';'),
    });
  }
  return bits;
}

const petals = makeFalling(COUNTS.petal, 9, 18, 11, 22);

const leafTones = ['a', 'b', 'c'];
const leaves = makeFalling(COUNTS.leaf, 13, 26, 10, 19).map((b, i) => ({
  ...b,
  cls: `fx__leaf--${leafTones[i % 3]}`,
}));

const snow = makeFalling(COUNTS.snow, 3, 8, 9, 20);

/* 光芒。左上のひとつの光源から、右下へ扇状に広がる */
const rays = Array.from({ length: COUNTS.ray }, (_, i) => {
  const t = i / (COUNTS.ray - 1);
  return {
    style: [
      `--x:${f(-4 + t * 9 + pick(-2, 2))}vw`,
      `--size:${f(pick(3, 14))}vw`,
      `--tilt:${f(-(24 + t * 36) + pick(-3, 3))}deg`,
      `--blur:${f(pick(12, 28), 0)}px`,
      `--o:${f(pick(0.45, 1), 2)}`,
      `--dur:${f(pick(7, 14), 2)}s`,
      `--delay:${f(-pick(0, 8), 2)}s`,
    ].join(';'),
  };
});

/* 光の粒。光の向きに沿って、左上から右下へゆっくり漂う */
const motes = Array.from({ length: COUNTS.mote }, () => ({
  style: [
    `--x:${f(pick(-5, 55))}vw`,
    `--y:${f(pick(-5, 45))}vh`,
    `--size:${f(pick(1.5, 5))}px`,
    `--dx:${f(pick(18, 55), 0)}vw`,
    `--dy:${f(pick(25, 70), 0)}vh`,
    `--blur:${f(pick(0, 1.6))}px`,
    `--dur:${f(pick(18, 34))}s`,
    `--delay:${f(-pick(0, 30))}s`,
  ].join(';'),
}));

/* 桜の花びらの形。舞う花びら・吹き溜まりで共通 */
const PETAL = 'M12 0C18 7 24 15 24 22c0 7-5 12-12 8-7 4-12-1-12-8C0 15 6 7 12 0z';

/* 若草。[根元x, 高さ, 傾き, 揺れの周期, 遅れ] */
const grass: [number, number, number, string, string][] = [
  [26, 74, 10, '5.8s', '-0.6s'],
  [44, 96, -8, '6.6s', '-2.4s'],
  [60, 62, 14, '5.2s', '-1.5s'],
  [82, 110, -6, '7.1s', '-3.3s'],
  [98, 84, 12, '6.0s', '-0.2s'],
  [120, 128, -12, '6.9s', '-2.9s'],
  [140, 70, 8, '5.5s', '-1.1s'],
  [162, 102, -10, '6.3s', '-3.8s'],
  [184, 88, 14, '5.9s', '-0.9s'],
];

/* 吹き溜まりに散る花びら。[x, y, 大きさ, 回転] */
const restingPetals: [number, number, number, number][] = Array.from({ length: 16 }, () => [
  pick(20, 1180),
  pick(48, 78),
  pick(0.55, 0.95),
  pick(-80, 80),
]);

/* 夏の葉の形。先の尖った楕円。原点が葉柄の付け根、先端が上 */
const LEAF = 'M0 0C-9-8-12-22 0-40 12-22 9-8 0 0z';

/* 夏の枝につける葉。[x, y, 回転, 大きさ, 色]
   幹に沿って左右に対で付け、小枝の先は房にする。 */
const summerLeaves: [number, number, number, number, 'a' | 'b'][] = [
  [244, 14, -62, 0.95, 'a'],
  [236, 20, 128, 0.8, 'b'],
  [214, 30, -54, 1.0, 'b'],
  [204, 38, 136, 0.85, 'a'],
  [184, 50, -48, 0.9, 'a'],
  [172, 62, 142, 0.8, 'b'],
  [152, 80, -42, 1.0, 'b'],
  [140, 92, 150, 0.85, 'a'],
  [108, 104, -36, 0.9, 'a'],
  [92, 108, 156, 0.8, 'b'],
  [74, 110, -20, 0.75, 'a'],
  /* 小枝の先の房 */
  [208, 92, -100, 0.85, 'b'],
  [206, 94, -40, 0.9, 'a'],
  [210, 90, 20, 0.7, 'b'],
  [124, 88, -120, 0.8, 'a'],
  [122, 90, -60, 0.85, 'b'],
];

/* 紅葉の形。舞う葉・枝の葉・落ち葉で共通 */
const MAPLE =
  'M50 2l8 22 18-8-6 20h22L76 52l12 18-22-6-2 24-14-16-14 16-2-24-22 6 12-18L8 36h22l-6-20 18 8z';

/* 秋の枝につける葉。[x, y, 大きさ, 回転, 色] */
const autumnLeaves: [number, number, number, number, string][] = [
  [236, 20, 17, -20, 'a'],
  [204, 42, 15, 30, 'b'],
  [206, 90, 13, 10, 'c'],
  [166, 76, 16, -35, 'a'],
  [126, 86, 14, 20, 'b'],
  [92, 98, 12, -10, 'c'],
  [150, 112, 10, 50, 'a'],
];

/* 霜の結晶。角から3本の主軸を伸ばし、それぞれに枝を付ける */
function frostPath() {
  const parts: string[] = [];
  for (const deg of [22, 45, 68]) {
    const len = deg === 45 ? 150 : 115;
    const a = (deg * Math.PI) / 180;
    parts.push(`M0 0L${f(Math.cos(a) * len)} ${f(Math.sin(a) * len)}`);
    for (let d = 22; d < len - 10; d += 18) {
      const bx = Math.cos(a) * d;
      const by = Math.sin(a) * d;
      const bl = (len - d) * 0.32;
      for (const side of [-1, 1]) {
        const b = a + (side * Math.PI) / 3;
        parts.push(`M${f(bx)} ${f(by)}l${f(Math.cos(b) * bl)} ${f(Math.sin(b) * bl)}`);
      }
    }
  }
  return parts.join(' ');
}
const FROST = frostPath();

/* すすき。[根元x, 穂先x, 穂先y, 揺れの周期, 遅れ] */
const stalks: [number, number, number, string, string][] = [
  [42, 56, 78, '5.6s', '-1.2s'],
  [86, 92, 58, '6.4s', '-3.1s'],
  [128, 118, 92, '5.1s', '-0.4s'],
  [170, 186, 70, '6.9s', '-2.2s'],
];
---

<div class="fx" aria-hidden="true">
  {/* ---------------- 春 ― 桜 ---------------- */}
  <div class="fx__season fx__season--spring">
    <div class="fx__field">
      {petals.map((p) => <span class="fx__bit fx__petal" style={p.style} />)}
    </div>

    {/* 右上の桜の枝 */}
    <div class="fx__corner">
      <svg viewBox="0 0 260 150" fill="none">
        <path
          d="M260 12c-30 6-58 20-82 40-18 15-32 33-52 44-16 9-34 13-52 13"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          opacity="0.55"></path>
        <path
          d="M214 40c-6 16-8 33-6 50M168 78c-14 6-29 9-44 9"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.45"></path>
        {
          [
            [238, 22, 11],
            [206, 44, 9],
            [208, 92, 8],
            [166, 78, 10],
            [124, 88, 8.5],
            [88, 100, 7],
          ].map(([cx, cy, r]) => (
            <g transform={`translate(${cx} ${cy})`} fill="var(--fx-petal)">
              <circle cx="0" cy={-r} r={r * 0.62} />
              <circle cx={r * 0.95} cy={-r * 0.3} r={r * 0.62} />
              <circle cx={r * 0.59} cy={r * 0.81} r={r * 0.62} />
              <circle cx={-r * 0.59} cy={r * 0.81} r={r * 0.62} />
              <circle cx={-r * 0.95} cy={-r * 0.3} r={r * 0.62} />
              <circle cx="0" cy="0" r={r * 0.3} fill="var(--color-accent)" opacity="0.8" />
            </g>
          ))
        }
      </svg>
    </div>

    {/* 左下の若草。根元を軸にゆっくり揺れ、いくつかに花びらが乗る */}
    <div class="fx__corner fx__corner--bl">
      <svg viewBox="0 0 220 160" fill="none">
        {
          grass.map(([x, h, lean, dur, delay], i) => (
            <g class="fx__stalk" style={`animation-duration:${dur};animation-delay:${delay}`}>
              <path
                d={`M${x} 160C${x + lean * 0.2} ${160 - h * 0.45} ${x + lean * 0.8} ${160 - h * 0.78} ${x + lean * 1.3} ${160 - h}`}
                stroke="var(--fx-grass)"
                stroke-width={i % 3 === 0 ? 2.4 : 1.8}
                stroke-linecap="round"
                opacity="0.78"
              />
              {i % 4 === 1 && (
                <g
                  transform={`translate(${x + lean * 1.1} ${160 - h * 0.9}) rotate(${lean * 3}) scale(0.5)`}
                >
                  <path d={PETAL} fill="var(--fx-petal)" opacity="0.9" />
                </g>
              )}
            </g>
          ))
        }
      </svg>
    </div>

    {/* 画面下部の花びらの吹き溜まり。薄い帯の上に、散った花びらが不揃いに乗る */}
    <div class="fx__ground">
      <svg viewBox="0 0 1200 90" preserveAspectRatio="none" fill="none">
        <path
          d="M0 76C90 70 170 82 260 78 350 74 440 66 530 74 620 82 710 84 800 78 890 72 980 66 1070 74 1130 79 1170 78 1200 76L1200 90 0 90Z"
          fill="var(--fx-petal)"
          opacity="0.16"
        />
      </svg>
      <svg viewBox="0 0 1200 90" preserveAspectRatio="xMidYMax slice" fill="none">
        {
          restingPetals.map(([x, y, sc, rot]) => (
            <g transform={`translate(${f(x, 0)} ${f(y, 0)}) rotate(${f(rot, 0)}) scale(${f(sc, 2)}) translate(-12 -17)`}>
              <path d={PETAL} fill="var(--fx-petal)" opacity="0.8" />
            </g>
          ))
        }
      </svg>
    </div>
  </div>

  {/* ---------------- 夏 ― 光芒と風鈴 ---------------- */}
  <div class="fx__season fx__season--summer">
    <div class="fx__field">
      {/* 左上の光源。ここから右下へ光が広がる */}
      <div class="fx__light">
        <span class="fx__glow"></span>
        {rays.map((r) => <span class="fx__ray" style={r.style} />)}
      </div>
      {motes.map((m) => <span class="fx__mote" style={m.style} />)}
    </div>

    {/* 右上の夏の枝。他季節と同じ幹に、青々とした葉を茂らせる */}
    <div class="fx__corner">
      <svg viewBox="0 0 260 150" fill="none">
        <path
          d="M260 12c-30 6-58 20-82 40-18 15-32 33-52 44-16 9-34 13-52 13"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          opacity="0.55"></path>
        <path
          d="M214 40c-6 16-8 33-6 50M168 78c-14 6-29 9-44 9"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.45"></path>
        {
          summerLeaves.map(([x, y, rot, sc, tone]) => (
            <g transform={`translate(${x} ${y}) rotate(${rot}) scale(${sc})`}>
              <path
                d={LEAF}
                fill={tone === 'a' ? 'var(--fx-leaf-summer)' : 'var(--fx-leaf-summer-light)'}
                opacity="0.92"
              />
              <path
                d="M0-4V-35"
                stroke="var(--color-paper)"
                stroke-width="1.1"
                stroke-linecap="round"
                opacity="0.45"
              />
            </g>
          ))
        }
      </svg>
    </div>
  </div>

  {/* ---------------- 秋 ― 紅葉 ---------------- */}
  <div class="fx__season fx__season--autumn">
    <div class="fx__field">
      {leaves.map((l) => <span class={`fx__bit fx__leaf ${l.cls}`} style={l.style} />)}
    </div>

    {/* 右上の紅葉の枝 */}
    <div class="fx__corner">
      <svg viewBox="0 0 260 150" fill="none">
        <path
          d="M260 12c-30 6-58 20-82 40-18 15-32 33-52 44-16 9-34 13-52 13"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          opacity="0.55"></path>
        <path
          d="M214 40c-6 16-8 33-6 50M168 78c-14 6-29 9-44 9"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.45"></path>
        {
          autumnLeaves.map(([x, y, s, rot, tone]) => (
            <g transform={`translate(${x} ${y}) rotate(${rot}) scale(${s / 100}) translate(-50 -46)`}>
              <path d={MAPLE} fill={`var(--fx-leaf-${tone})`} opacity="0.9" />
            </g>
          ))
        }
      </svg>
    </div>

    {/* 左下のすすき。落ち葉の山から立ち上がり、穂がゆっくり揺れる */}
    <div class="fx__corner fx__corner--bl">
      <svg viewBox="0 0 220 260" fill="none">
        {
          stalks.map(([bx, tx, ty, dur, delay]) => (
            <g
              class="fx__stalk"
              style={`animation-duration:${dur};animation-delay:${delay}`}
            >
              <path
                d={`M${bx} 260C${bx + 6} 210 ${tx - 10} 150 ${tx} ${ty + 60}`}
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                opacity="0.5"
              />
              <g transform={`translate(${tx} ${ty + 60}) rotate(${(tx - bx) * 0.9})`}>
                <path
                  d="M0 0c9-16 11-40 0-64-11 24-9 48 0 64z"
                  fill="var(--fx-plume)"
                  opacity="0.85"
                />
                <path
                  d="M0-8c6-8 7-22 3-38M0-14c-6-8-7-22-3-38M1-24c5-6 5-14 2-24M-1-28c-5-6-5-14-2-24"
                  stroke="var(--color-paper)"
                  stroke-width="0.9"
                  stroke-linecap="round"
                  opacity="0.6"
                />
              </g>
            </g>
          ))
        }
      </svg>
    </div>

    {/* 画面下部の落ち葉。画面幅いっぱいまで続く */}
    <div class="fx__ground">
      <svg viewBox="0 0 1200 90" preserveAspectRatio="none" fill="none">
        <path
          d="M0 62C60 52 140 70 200 64 260 58 340 44 400 56 460 68 540 78 600 66 660 54 740 46 800 58 860 70 940 76 1000 64 1060 52 1140 50 1200 60L1200 90 0 90Z"
          fill="var(--fx-leaf-b)"
          opacity="0.3"></path>
        <path
          d="M0 74C80 66 160 82 240 76 320 70 400 62 480 72 560 82 640 84 720 76 800 68 880 62 960 72 1040 82 1120 80 1200 74L1200 90 0 90Z"
          fill="var(--fx-leaf-a)"
          opacity="0.35"></path>
        {
          [
            [90, 58, 15, -18],
            [260, 50, 19, 24],
            [430, 62, 14, -8],
            [610, 48, 21, 12],
            [780, 60, 16, -26],
            [950, 52, 18, 8],
            [1110, 60, 15, 20],
          ].map(([x, y, s, rot], i) => (
            <g transform={`translate(${x} ${y}) rotate(${rot}) scale(${Number(s) / 100})`}>
              <path d={MAPLE} fill={`var(--fx-leaf-${['a', 'b', 'c'][i % 3]})`} opacity="0.8" />
            </g>
          ))
        }
      </svg>
    </div>
  </div>

  {/* ---------------- 冬 ― 雪 ---------------- */}
  <div class="fx__season fx__season--winter">
    <div class="fx__field">{snow.map((s) => <span class="fx__bit fx__snow" style={s.style} />)}</div>

    {/* 右上の雪をかぶった枝 */}
    <div class="fx__corner">
      <svg viewBox="0 0 260 150" fill="none">
        {/* 葉のない枝 */}
        <path
          d="M260 14c-30 6-58 20-82 40-18 15-32 33-52 44-16 9-34 13-52 13"
          stroke="currentColor"
          stroke-width="3.2"
          stroke-linecap="round"
          opacity="0.6"></path>
        <path
          d="M214 42c-6 16-8 33-6 50M168 80c-14 6-29 9-44 9M232 30c-10-2-20-1-28 3"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.5"></path>
        {/* 枝の上面に乗る雪。少し上にずらして、途切れさせながら描く */}
        <path
          d="M260 10c-30 6-58 20-82 40-18 15-32 33-52 44-16 9-34 13-52 13"
          stroke="var(--fx-snow)"
          stroke-width="6"
          stroke-linecap="round"
          stroke-dasharray="30 14 18 20 26 12"
          opacity="0.95"></path>
        <path
          d="M214 38c-6 16-8 33-6 50M168 76c-14 6-29 9-44 9"
          stroke="var(--fx-snow)"
          stroke-width="4"
          stroke-linecap="round"
          stroke-dasharray="12 10 16 12"
          opacity="0.9"></path>
        {[[229, 26], [199, 51], [147, 92], [96, 110]].map(([cx, cy]) => (
          <circle cx={cx} cy={cy} r="2.2" fill="var(--fx-snow)" opacity="0.9" />
        ))}
      </svg>
    </div>

    {/* 窓の霜。左上と右下の角から、開いたときにゆっくり伸びる */}
    <div class="fx__frost fx__frost--tl">
      <svg viewBox="0 0 160 160" fill="none">
        <path d={FROST} pathLength="1" stroke="var(--fx-snow)" stroke-width="1.3" stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="fx__frost fx__frost--br">
      <svg viewBox="0 0 160 160" fill="none">
        <path d={FROST} pathLength="1" stroke="var(--fx-snow)" stroke-width="1.3" stroke-linecap="round"></path>
      </svg>
    </div>

    {/* 画面下部の積雪 */}
    <div class="fx__ground">
      <svg viewBox="0 0 1200 90" preserveAspectRatio="none" fill="none">
        <path
          d="M0 90V66c80-14 150 2 230-4s150-18 230-12 150 20 230 14 150-18 230-12 80 12 280 10v28z"
          fill="var(--fx-snow)"
          opacity="0.4"></path>
        <path
          d="M0 90V76c100-10 190 4 290-2s180-14 280-8 190 16 290 10 140-10 340-8v22z"
          fill="var(--fx-snow)"
          opacity="0.72"></path>
      </svg>
    </div>
  </div>
</div>
