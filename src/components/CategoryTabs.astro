---
/**
 * カテゴリタブ。
 * 最上部のヘッダーバーと、スクロール時に開くメニューパネルの
 * 両方から同じコンポーネントを使い回している（variant で見た目だけ変える）。
 */
import { navItems, type NavId } from '../config/site';

interface Props {
  /** 現在のページ。タブのハイライトに使う */
  current?: NavId;
  /** 'bar' = 最上部の横並び / 'menu' = 右上メニュー内の縦並び */
  variant?: 'bar' | 'menu';
}

const { current = 'top', variant = 'bar' } = Astro.props;
---

<nav class={`tabs tabs--${variant}`} aria-label="カテゴリ">
  <ul class="tabs__list">
    {
      navItems.map((item) => (
        <li class="tabs__item">
          <a
            class="tabs__link"
            href={item.href}
            aria-current={current === item.id ? 'page' : undefined}
          >
            <span class="tabs__label">{item.label}</span>
            <span class="tabs__sub">{item.sub}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabs__list {
    display: flex;
  }

  .tabs__link {
    display: block;
    color: var(--color-muted);
    /* クリック要素の文字は折り返さない */
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tabs__label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.6;
  }

  .tabs__sub {
    display: block;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    line-height: 1.5;
    color: var(--color-neutral);
  }

  /* ---------------- 最上部のバー ---------------- */
  .tabs--bar .tabs__list {
    gap: clamp(0.25rem, 2vw, 1.5rem);
    /* 狭い画面では横スクロールで全タブに触れるようにする */
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tabs--bar .tabs__list::-webkit-scrollbar {
    display: none;
  }

  .tabs--bar .tabs__link {
    padding: var(--space-2xs) var(--space-xs) var(--space-xs);
    border-bottom: 2px solid transparent;
  }

  .tabs--bar .tabs__link:hover,
  .tabs--bar .tabs__link:active {
    color: var(--color-ink);
  }

  /* 現在のページ。差し色はここに限定する */
  .tabs--bar .tabs__link[aria-current='page'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  .tabs--bar .tabs__link[aria-current='page'] .tabs__sub {
    color: var(--color-accent);
  }

  /* 狭い画面では英字の副題を隠す。
     クリックできる文字が2行になるのを避けるため。 */
  @media (max-width: 46rem) {
    .tabs--bar .tabs__sub {
      display: none;
    }

    .tabs--bar .tabs__link {
      padding-block: var(--space-xs);
    }
  }

  /* ---------------- メニュー内の縦並び ---------------- */
  .tabs--menu .tabs__list {
    flex-direction: column;
  }

  .tabs--menu .tabs__link {
    padding: var(--space-sm) var(--space-md);
    border-left: 2px solid transparent;
  }

  .tabs--menu .tabs__link:hover {
    color: var(--color-ink);
    background: var(--color-paper-2);
  }

  .tabs--menu .tabs__link[aria-current='page'] {
    color: var(--color-ink);
    border-left-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  /* メニュー内は縦に余裕があるので副題を残す */
  .tabs--menu .tabs__sub {
    font-size: var(--text-2xs);
  }
</style>
