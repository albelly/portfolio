---
/**
 * 全ページ冒頭に置く「どんな制作ができる人か」の自己紹介エリア。
 * 文言は src/config/site.ts の profile を編集すれば全ページに反映される。
 *
 * variant:
 *   'full'    … TOPページ用。セリフ・対応可能な業務まで出す
 *   'compact' … カテゴリページ用。見出しと説明のみ
 */
import { profile } from '../config/site';

interface Props {
  /** ページ固有の見出し。省略時はキャッチフレーズを使う */
  heading?: string;
  /** ページ固有のリード文 */
  lead?: string;
  variant?: 'full' | 'compact';
}

const { heading, lead, variant = 'full' } = Astro.props;
---

<section class="intro">
  <div class="container">
    <p class="intro__name">
      {profile.name}<span class="intro__role">{profile.role}</span>
    </p>

    <h1 class="intro__heading">{heading ?? profile.tagline}</h1>

    <div class="intro__body">
      {lead ? <p>{lead}</p> : profile.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      variant === 'full' && (
        <>
          <div class="intro__voices">
            {profile.voices.map((voice) => (
              <p class="intro__voice">「{voice}」</p>
            ))}
            <p class="intro__voice-answer">{profile.voicesAnswer}</p>
          </div>

          <div class="intro__services">
            <h2 class="intro__services-title">対応可能な業務</h2>
            <ul class="intro__service-list">
              {profile.services.map((service) => (
                <li class="intro__service">
                  <h3 class="intro__service-title">{service.title}</h3>
                  <p class="intro__service-body">{service.body}</p>
                </li>
              ))}
            </ul>
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .intro {
    background: var(--hero-bg);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .intro__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .intro__role {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .intro__heading {
    max-width: 26em;
  }

  .intro__body {
    margin-top: 1.1rem;
    max-width: 42rem;
    color: var(--color-text-muted);
    display: grid;
    gap: 0.8rem;
  }

  /* ---------------- 依頼者の声（セリフ） ---------------- */
  .intro__voices {
    margin-top: clamp(1.75rem, 4vw, 2.25rem);
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    max-width: 42rem;
  }

  .intro__voice {
    font-weight: 600;
    line-height: 1.9;
  }

  .intro__voice-answer {
    margin-top: 0.7rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  /* ---------------- 対応可能な業務 ---------------- */
  .intro__services {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .intro__services-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.8rem;
  }

  .intro__service-list {
    display: grid;
    gap: 1rem;
    /* 画面幅に応じて 1〜4 列へ自動で切り替わる */
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .intro__service {
    padding: 1.1rem 1.2rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .intro__service-title {
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .intro__service-body {
    font-size: 0.85rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
</style>
