---
/**
 * 全ページ冒頭に置く「どんな制作ができる人か」の自己紹介エリア。
 * 文言は src/config/site.ts の profile を編集すれば全ページに反映される。
 *
 * variant:
 *   'full'    … TOPページ用。セリフ・対応可能な業務まで出す
 *   'compact' … カテゴリページ用。見出しと説明のみ
 */
import { profile } from '../config/site';

interface Props {
  /** ページ固有の見出し。省略時はキャッチフレーズを使う */
  heading?: string;
  /** ページ固有のリード文 */
  lead?: string;
  variant?: 'full' | 'compact';
}

const { heading, lead, variant = 'full' } = Astro.props;
---

<section class={`intro intro--${variant}`}>
  <div class="container">
    <div class="intro__catch">
      <h1 class="intro__heading">{heading ?? profile.tagline}</h1>
      {/* 柱。和の書籍にならい、版面の端に縦組で仕事の内容を添える */}
      <p class="intro__column vertical">Webサイト・LP制作</p>
    </div>

    <div class="prose intro__body">
      {lead ? <p>{lead}</p> : profile.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      variant === 'full' && (
        <>
          {/* 依頼者の言葉。本文から一段下げて引用として置く */}
          <div class="intro__voices">
            {profile.voices.map((voice) => (
              <p class="intro__voice">「{voice}」</p>
            ))}
          </div>

          <p class="prose intro__answer">{profile.voicesAnswer}</p>

          <div class="intro__services">
            <h2 class="section__title">対応できること</h2>
            <dl class="deflist">
              {profile.services.map((service) => (
                <div class="deflist__row">
                  <dt class="deflist__term">{service.title}</dt>
                  <dd class="deflist__desc">{service.body}</dd>
                </div>
              ))}
            </dl>
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  /* 下の余白を上より大きく取り、次の節へ読み進む流れを作る */
  .intro {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .intro--compact {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  /* 見出しと縦組の柱。狭い画面では柱を隠す */
  .intro__catch {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xl);
  }

  .intro__heading {
    max-width: 22em;
    flex: 1 1 auto;
    min-width: 0;
  }

  .intro__column {
    flex: 0 0 auto;
    margin-left: auto;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    max-height: 14em;
  }

  @media (max-width: 60rem) {
    .intro__column {
      display: none;
    }
  }

  .intro__body {
    margin-top: var(--space-xl);
  }

  /* ---------------- 依頼者の言葉 ---------------- */
  .intro__voices {
    margin-top: var(--space-xl);
    padding-left: var(--space-lg);
    border-left: 2px solid var(--color-accent);
    max-width: var(--measure);
  }

  .intro__voice {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-heading);
    color: var(--color-ink);
    /* 見出しと同じく文節で折り返す。「ない」だけが次行に落ちるのを防ぐ */
    word-break: auto-phrase;
  }

  .intro__voice + .intro__voice {
    margin-top: var(--space-xs);
  }

  .intro__answer {
    margin-top: var(--space-lg);
  }

  /* ---------------- 対応できること ---------------- */
  .intro__services {
    margin-top: var(--space-2xl);
  }
</style>
