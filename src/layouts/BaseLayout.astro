---
/**
 * 全ページ共通のレイアウト。
 *
 * 【構造】
 *   <header>          … 最上部のカテゴリタブ（全ページ共通）
 *   #header-sentinel  … スクロール判定用の目印（高さ0・見えない）
 *   <FloatingMenu>    … 目印が画面外に出たら右上に現れるメニュー
 *   <main>            … 各ページの中身
 *   <Footer>
 *
 * 【テーマ】
 *   theme プロパティが <html data-theme="..."> になり、
 *   themes.css の配色が切り替わる。
 */
import '../styles/themes.css';
import '../styles/global.css';

import CategoryTabs from '../components/CategoryTabs.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import Footer from '../components/Footer.astro';
import { profile, site, type NavId } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** themes.css で定義したテーマ名。既定はTOP向けの配色 */
  theme?: 'base' | 'web' | 'apps' | 'images';
  /** 現在のページ。タブのハイライトに使う */
  current?: NavId;
}

const { title, description = site.description, theme = 'base', current = 'top' } = Astro.props;

const pageTitle = current === 'top' ? site.title : `${title} | ${site.shortTitle}`;
---

<!doctype html>
<html lang="ja" data-theme={theme} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- OGP（Phase 4 で画像を追加する） -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.shortTitle} />

    <!-- JavaScript が有効なら no-js クラスを外す。
         スクロール連動メニューはJS前提のため、無効時は非表示にする。 -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">{profile.name}</a>
        <CategoryTabs current={current} variant="bar" />
      </div>
    </header>

    <!-- スクロール判定用の目印。これが画面外に出たら右上メニューを出す -->
    <div id="header-sentinel" aria-hidden="true"></div>

    <FloatingMenu current={current} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .site-header__brand {
    flex-shrink: 0;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--color-accent);
  }

  /* 判定用の目印。見た目には一切影響しない */
  #header-sentinel {
    height: 0;
  }

  /* 画面が狭いときはブランド名を上、タブを下の2段にする */
  @media (max-width: 560px) {
    .site-header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 0.6rem;
    }

    .site-header__brand {
      padding-bottom: 0.4rem;
    }
  }
</style>
