---
/**
 * 全ページ共通のレイアウト。
 *
 * 【構造】
 *   <header>          … 最上部のカテゴリタブ（全ページ共通）
 *   #header-sentinel  … スクロール判定用の目印（高さ0・見えない）
 *   <FloatingMenu>    … 目印が画面外に出たら右上に現れるメニュー
 *   <main>            … 各ページの中身
 *   <Footer>
 *
 * 【テーマ】
 *   theme プロパティが <html data-theme="..."> になり、
 *   themes.css の配色が切り替わる。
 */
import '../styles/tokens.css';
import '../styles/themes.css';
import '../styles/global.css';

import CategoryTabs from '../components/CategoryTabs.astro';
import FloatingMenu from '../components/FloatingMenu.astro';
import Footer from '../components/Footer.astro';
import { profile, site, type NavId, type ThemeName } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** themes.css で定義したテーマ名。既定はTOP向けの配色 */
  theme?: ThemeName;
  /** 現在のページ。タブのハイライトに使う */
  current?: NavId;
}

const { title, description = site.description, theme = 'base', current = 'top' } = Astro.props;

const pageTitle = current === 'top' ? site.title : `${title} | ${site.shortTitle}`;
---

<!doctype html>
<html lang="ja" data-theme={theme} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- 書体。明朝（見出し）＋ゴシック（本文）の2種のみ読み込む。
         日本語フォントは Google Fonts 側で必要な文字範囲だけが配信される。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;600;700&display=swap"
    />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.shortTitle} />

    <!-- JavaScript が有効なら no-js クラスを外す。
         スクロール連動メニューはJS前提のため、無効時は非表示にする。 -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          <span class="site-header__name">{profile.name}</span>
          <span class="site-header__role">{profile.role}</span>
        </a>
        <CategoryTabs current={current} variant="bar" />
      </div>
    </header>

    <!-- スクロール判定用の目印。これが画面外に出たら右上メニューを出す -->
    <div id="header-sentinel" aria-hidden="true"></div>

    <FloatingMenu current={current} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-header {
    background: var(--color-paper);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .site-header__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 4rem;
    padding-block: var(--space-sm);
  }

  .site-header__brand {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .site-header__brand:hover {
    color: var(--color-ink);
  }

  .site-header__brand:hover .site-header__name {
    color: var(--color-accent);
  }

  .site-header__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-header__role {
    font-size: var(--text-xs);
    color: var(--color-neutral);
    letter-spacing: var(--tracking-label);
  }

  /* 判定用の目印。見た目には一切影響しない */
  #header-sentinel {
    height: 0;
  }

  /* 画面が狭いときはブランド名を上、タブを下の2段にする */
  @media (max-width: 46rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-xs);
    }

    .site-header__role {
      display: none;
    }
  }
</style>
