---
/**
 * カテゴリページ（/web/ など）。
 *
 * site.ts の categories のうち enabled が true のものだけ、
 * ここから自動でページが生成される。
 * カテゴリを増やすときに、このファイルを触る必要はない。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSection from '../components/IntroSection.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { activeCategories, worksByCategory, type Category } from '../config/site';

export function getStaticPaths() {
  return activeCategories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const items = worksByCategory(category.id);
---

<BaseLayout
  title={category.heading}
  description={category.description}
  theme={category.theme}
  current={category.id}
>
  <IntroSection heading={category.heading} lead={category.description} variant="compact" />

  <section class="section" data-reveal>
    <div class="container">
      <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <h2 class="section__title">制作したもの</h2>
      </div>
      <p class="section__lead">
        現在ポートフォリオを制作中です。準備ができ次第、順次掲載していきます。
      </p>

      <WorkGrid works={items} layout={category.layout} />
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <h2 class="section__title">{category.detailHeading}</h2>
      </div>
      </div>
      <div class="placeholder">ご相談から公開までの流れなどは、この後の工程で追加します。</div>
    </div>
  </section>
</BaseLayout>
