---
/**
 * ② Webアプリ
 * 別サイトとして公開したアプリへのリンク、または埋め込みで見せる想定。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSection from '../components/IntroSection.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { getCategory, worksByCategory } from '../config/site';

const category = getCategory('apps');
const items = worksByCategory('apps');
---

<BaseLayout
  title={category.heading}
  description={category.description}
  theme="apps"
  current="apps"
>
  <IntroSection heading={category.heading} lead={category.description} variant="compact" />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="section-head__label">Works</span>
        <h2>開発実績</h2>
        <p class="section-head__lead">
          実際に動作するアプリをご確認いただけます。
        </p>
      </div>

      <WorkGrid works={items} layout="grid" />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <span class="section-head__label">Detail</span>
        <h2>対応できること</h2>
      </div>
      <div class="placeholder">
        対応可能な機能、使用技術、開発の進め方などはこの後の工程で追加します。
      </div>
    </div>
  </section>
</BaseLayout>
