---
/**
 * ③ 画像生成（ロゴ / アイコン / LINEスタンプ など）
 * 画像を直接埋め込み、説明を添えて縦にスクロールして見せる。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSection from '../components/IntroSection.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { getCategory, worksByCategory } from '../config/site';

const category = getCategory('images');
const items = worksByCategory('images');
---

<BaseLayout
  title={category.heading}
  description={category.description}
  theme="images"
  current="images"
>
  <IntroSection heading={category.heading} lead={category.description} showSkills={false} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="section-head__label">Works</span>
        <h2>制作実績</h2>
        <p class="section-head__lead">
          制作したビジュアルを、意図や経緯の説明とあわせて掲載しています。
        </p>
      </div>

      <!-- 画像は1件ずつ大きく縦に並べる -->
      <WorkGrid works={items} layout="stack" />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-head">
        <span class="section-head__label">Detail</span>
        <h2>制作できるもの</h2>
      </div>
      <div class="placeholder">
        対応できる形式、納品データ、修正回数などはこの後の工程で追加します。
      </div>
    </div>
  </section>
</BaseLayout>
