---
/**
 * TOPページ。
 *
 * 書簡のように、上から順に読んでいける構成にしている。
 * 英字ラベル（WORKS / ABOUT 等）は置かず、日本語の見出しと罫線だけで区切る。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroSection from '../components/IntroSection.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { activeCategories, categoryHref, featuredWorks, profile } from '../config/site';

const picks = featuredWorks(3);
---

<BaseLayout title="TOP" theme="base" current="top">
  <!-- 自己紹介・対応できること -->
  <IntroSection variant="full" />

  <!-- カテゴリ案内。カテゴリが2つ以上あるときだけ出す -->
  {
    activeCategories.length > 1 && (
      <section class="section" data-reveal>
        <div class="container">
          <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <h2 class="section__title">制作の分野</h2>
      </div>
          <ul class="categories">
            {activeCategories.map((category) => (
              <li>
                <a class="categories__link" href={categoryHref(category.id)}>
                  <span class="categories__name">{category.label}</span>
                  <span class="categories__body">{category.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 作品の簡易一覧 -->
  <section class="section" data-reveal>
    <div class="container">
      <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <h2 class="section__title">制作したもの</h2>
      </div>
      <p class="section__lead">
        現在ポートフォリオを制作中です。準備ができ次第、順次掲載していきます。
      </p>

      <WorkGrid works={picks} layout="grid" />

      {
        activeCategories.length > 0 && (
          <p class="works-more">
            <a class="button" href={categoryHref(activeCategories[0].id)}>
              すべて見る
            </a>
          </p>
        )
      }
    </div>
  </section>

  <!-- 制作にあたって -->
  <section class="section" data-reveal>
    <div class="container">
      <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <h2 class="section__title">制作にあたって</h2>
      </div>
      <div class="prose">
        {profile.closing.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- 稼働について -->
  <section class="section" data-reveal>
    <div class="container">
      <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <h2 class="section__title">稼働について</h2>
      </div>
      <dl class="deflist">
        {
          profile.workStyle.map((item) => (
            <div class="deflist__row">
              <dt class="deflist__term">{item.label}</dt>
              <dd class="deflist__desc">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ご依頼窓口 -->
  <section class="section" id="contact" data-reveal>
    <div class="container">
      <div class="section__head">
        <p class="section__num" aria-hidden="true"></p>
        <h2 class="section__title">ご依頼・ご相談</h2>
      </div>
      <p class="section__lead">
        下記いずれかのサービスからご連絡ください。まだイメージが固まっていない段階でも構いません。
      </p>

      <ul class="contacts">
        {
          profile.profiles.map((item) => (
            <li class="contacts__item">
              <a class="contacts__link" href={item.href} target="_blank" rel="noopener noreferrer">
                <span class="contacts__name">{item.label}</span>
                <span class="contacts__note">{item.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- 制作の分野 ---------------- */
  .categories {
    border-top: var(--rule-width) solid var(--color-rule);
    max-width: calc(var(--measure) + 8em);
  }

  .categories__link {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-md);
    border-bottom: var(--rule-width) solid var(--color-rule);
    color: var(--color-ink);
  }

  .categories__link:hover {
    color: var(--color-ink);
  }

  .categories__link:hover .categories__name {
    color: var(--color-accent);
  }

  .categories__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .categories__body {
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    color: var(--color-muted);
  }

  .works-more {
    margin-top: var(--space-xl);
  }

  /* ---------------- ご依頼窓口 ---------------- */
  .contacts {
    border-top: var(--rule-width) solid var(--color-rule);
    max-width: 30rem;
  }

  .contacts__item {
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .contacts__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    color: var(--color-ink);
    white-space: nowrap;
  }

  .contacts__link::after {
    content: '→';
    margin-left: auto;
    color: var(--color-accent);
  }

  .contacts__link:hover {
    color: var(--color-accent);
  }

  .contacts__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
  }

  .contacts__note {
    font-size: var(--text-xs);
    color: var(--color-neutral);
  }
</style>
